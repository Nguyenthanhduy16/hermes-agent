# Dien tren may cua ban. Khong gui gia tri vao chat hoac Git.
ZALO_BOT_TOKEN=
# ID nguoi dung lay bang .\scripts\run.ps1 Discover
ZALO_ALLOWED_USERS=
# De trong de tat hoan toan chat nhom. Nhom can CA group ID VA user ID.
ZALO_ALLOWED_GROUPS=
# allowlist: chi nguoi duoc cap quyen; members: moi thanh vien trong nhom DUOC PHEP
# duoc hoi lich/tai lieu da chia se va tro chuyen khi @bot/reply.
# DM/nhac/issue van can quyen rieng; doi ca can lien ket da xac minh.
ZALO_GROUP_ACCESS=allowlist
# API key/model duoc cau hinh bang .\scripts\run.ps1 Model
# State va cau hinh Hermes rieng nam trong .runtime/ (da loai khoi Git).
# Thu muc tai lieu UTF-8 .md/.txt; manifest.json cap quyen tung tai lieu.
ZALO_KNOWLEDGE_DIR=data/knowledge
# Google Sheets: de trong ID de tat tich hop; khong can cho tai lieu/nhac viec.
ZALO_SHEETS_ID=
ZALO_GOOGLE_CREDENTIALS=secrets/google-service-account.json
ZALO_CALENDAR_TAB=Lich
ZALO_ISSUES_TAB=Issues
# Quyen Sheets rieng, ngoai danh sach quyen bot phia tren.
ZALO_SHEETS_USERS=
ZALO_SHEETS_GROUPS=
# standard: bang mau Lich; lab: bang phan cong co ngay, STT va o gop.
ZALO_CALENDAR_FORMAT=standard
# Che do lab: danh sach JSON 1-4 ten tab duoc phep doc, vi du ["Lich lab thu"]
ZALO_CALENDAR_TABS_JSON=[]
# De trong: standard bat issue, lab tat issue. Dat false de chi doc lich.
ZALO_ISSUES_ENABLED=
# URL trang web cu (legacy), KHONG can cho Tickets qua tin nhan rieng Zalo.
# Giu trong neu chi dung chat; huong dan hien tai: docs/tickets-chat.md.
TICKETS_PUBLIC_URL=
# Mac dinh A tao -> B dong y -> quan ly duyet.
TICKETS_REQUIRE_MANAGER=true
# Tickets DM: off, sheets_test, lab_live, lab_live_test. KHONG dung demo tren Zalo that.
TICKETS_CHAT_MODE=off
# Cung du lieu voi trang web thu. Chi chay MOT web/gateway su dung thu muc nay.
TICKETS_DATA_DIR=.runtime/tickets
# Sheets test PHAI la bang RIENG, khac ZALO_SHEETS_ID (khong sua bang Lab o gop).
TICKETS_TEST_SHEETS_ID=
TICKETS_TEST_SHEETS_TAB=TicketsTest
TICKETS_TEST_GOOGLE_CREDENTIALS=secrets/tickets-test-service-account.json
# Chi bat sau khi cap quyen vao bang thu va doc docs/tickets-chat.md.
TICKETS_TEST_WRITE_ENABLED=false
# true la cam ket chi dich vu doi ca duoc ghi bang nay; khong nguoi/tool khac sua.
TICKETS_TEST_EXCLUSIVE_WRITER=false
# lab_live dung bang ZALO_SHEETS_ID hien co, chi doi cot D (Lab Coach).
# Giu tat ghi cho den khi da xac nhan gio ca va quyen ghi doc quyen.
TICKETS_LAB_WRITE_ENABLED=false
TICKETS_LAB_EXCLUSIVE_WRITER=false
# JSON anh xa ten buoi sang gio start/end HH:MM; KHONG tu doan gio.
# De trong van check-lab/import-zalo-users duoc, chua chon/doi ca duoc.
TICKETS_LAB_PERIODS_JSON=
# Thu tren Sheets THAT: chi 2 nguoi da xac minh, cho ca cu; bo kiem tra gio/trung ca.
# Che do lab_live_test dung co rieng, KHONG bat ghi lab_live thong thuong.
TICKETS_LAB_TEST_MEMBERS_JSON=[]
TICKETS_LAB_TEST_WRITE_ENABLED=false
TICKETS_LAB_TEST_EXCLUSIVE_WRITER=false
