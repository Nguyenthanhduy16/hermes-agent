# Dien tren may cua ban. Khong gui gia tri vao chat hoac Git.
ZALO_BOT_TOKEN=
# ID nguoi dung lay bang .\scripts\run.ps1 Discover
ZALO_ALLOWED_USERS=
# De trong de tat hoan toan chat nhom. Nhom can CA group ID VA user ID.
ZALO_ALLOWED_GROUPS=
# allowlist: chi nguoi duoc cap quyen; members: moi thanh vien trong nhom DUOC PHEP
# duoc hoi lich/tai lieu da chia se voi nhom. DM/nhac/issue van can quyen rieng.
ZALO_GROUP_ACCESS=allowlist
# API key/model duoc cau hinh bang .\scripts\run.ps1 Model
# State va cau hinh Hermes rieng nam trong .runtime/ (da loai khoi Git).
# Thu muc tai lieu UTF-8 .md/.txt; manifest.json cap quyen tung tai lieu.
ZALO_KNOWLEDGE_DIR=data/knowledge
# Google Sheets: de trong ID de tat tich hop; khong can cho tai lieu/nhac viec.
ZALO_SHEETS_ID=
ZALO_GOOGLE_CREDENTIALS=secrets/google-service-account.json
ZALO_CALENDAR_TAB=Lich
ZALO_ISSUES_TAB=Issues
# Quyen Sheets rieng, ngoai danh sach quyen bot phia tren.
ZALO_SHEETS_USERS=
ZALO_SHEETS_GROUPS=
# standard: bang mau Lich; lab: bang phan cong co ngay, STT va o gop.
ZALO_CALENDAR_FORMAT=standard
# Che do lab: danh sach JSON 1-4 ten tab duoc phep doc, vi du ["Lich lab thu"]
ZALO_CALENDAR_TABS_JSON=[]
# De trong: standard bat issue, lab tat issue. Dat false de chi doc lich.
ZALO_ISSUES_ENABLED=
