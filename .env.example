# Dien tren may cua ban. Khong gui gia tri vao chat hoac Git.
ZALO_BOT_TOKEN=
# ID nguoi dung lay bang .\scripts\run.ps1 Discover
ZALO_ALLOWED_USERS=
# De trong de tat chat nhom. allowlist can ca group ID va user ID; members can group ID.
ZALO_ALLOWED_GROUPS=
# allowlist: chi nguoi duoc cap quyen; members: moi thanh vien trong nhom DUOC PHEP
# duoc hoi lich/tai lieu da chia se va tro chuyen khi @bot/reply.
# DM can allowlist hoac dang ky da duyet; duyet mo lich/doi ca/nhac viec/gop y/chat.
# Issue can bat toan he thong + tab hop le; khong tu cap quyen nhom/quan tri.
ZALO_GROUP_ACCESS=allowlist
# API key/model duoc cau hinh bang .\scripts\run.ps1 Model
# AI chi hieu cau chua khop mau; dung lai model/provider Hermes, khong tu doi model.
# Bat sau khi NluCheckLive dat; false giu nguyen luong lenh/mau cau cu.
ZALO_NLU_ENABLED=false
ZALO_NLU_TIMEOUT_SECONDS=12
# Mac dinh json_schema; voi LiteLLM chi ho tro JSON: json_object, van kiem tra schema trong code.
ZALO_NLU_RESPONSE_FORMAT=json_schema
ZALO_NLU_MAX_TOKENS=2048
ZALO_NLU_MAX_RETRIES=2
# default khong gui tham so; disabled/enabled chi khi endpoint ho tro thinking.
ZALO_NLU_THINKING=default
ZALO_CHAT_MAX_TOKENS=4096
# State va cau hinh Hermes rieng nam trong .runtime/ (da loai khoi Git).
# Thu muc tai lieu UTF-8 .md/.txt; manifest.json cap quyen tung tai lieu.
# approved_members:true trong manifest chia se file do cho thanh vien da duyet o DM.
# Mac dinh false: khong tu mo tai lieu rieng hoac quyen nhom.
ZALO_KNOWLEDGE_DIR=data/knowledge
# Google Sheets: de trong ID de tat tich hop; khong can cho tai lieu/nhac viec.
ZALO_SHEETS_ID=
ZALO_GOOGLE_CREDENTIALS=secrets/google-service-account.json
ZALO_CALENDAR_TAB=Lich
ZALO_ISSUES_TAB=Issues
# Quyen Sheets cu; thanh vien Workload da duyet KHONG can them ID cho chuc nang DM.
# Quyen nhom van phai khai bao rieng, dang ky DM khong mo them nhom.
ZALO_SHEETS_USERS=
ZALO_SHEETS_GROUPS=
# standard: bang mau Lich; lab: bang phan cong co ngay, STT va o gop.
ZALO_CALENDAR_FORMAT=standard
# Che do lab: danh sach JSON 1-4 ten tab duoc phep doc, vi du ["Lich lab thu"]
ZALO_CALENDAR_TABS_JSON=[]
# Nhac lich Lab Coach tu dong qua DM; chi thanh vien Workload da duyet, khop dung nguoi.
# Bat sau khi kiem tra lich, anh xa danh tinh va gio ca. Xem docs/nhac-lich-tu-dong.md.
ZALO_AUTO_REMINDERS_ENABLED=false
# Gio Viet Nam: mot ban tong hop lich ngay mai + nhac truoc tung ca.
ZALO_AUTO_REMINDERS_EVENING_TIME=20:00
ZALO_AUTO_REMINDERS_LEAD_MINUTES=30
ZALO_AUTO_REMINDERS_POLL_SECONDS=60
# De trong: standard bat issue, lab tat issue. Dat false de chi doc lich.
ZALO_ISSUES_ENABLED=
# legacy: giu nguon Sheets cu; managed: quan ly Issue tren Admin/SQLite cung Volume.
# off: tat thao tac/thong bao Issue, giu du lieu.
# Chi bat managed sau doi soat snapshot day du (ke ca nguon trong). Xem docs/ISSUES.md.
ZALO_ISSUES_MODE=legacy
# Dang ky so dien thoai: chi nhan trong tin nhan RIENG; mac dinh tat.
# Xem docs/dang-ky.md. Khong dien so dien thoai/danh ba vao file nay.
# Duyet mot lan mo lich/doi ca/nhac viec/gop y/chat tai DM da lien ket.
# Issue khi da bat + tab hop le; tai lieu can manifest chia se. Khong sua .env tung nguoi.
# Dung /thanhvien de xem, /thuhoidangky MA_THANH_VIEN de thu hoi ngay.
REGISTRATION_ENABLED=false
# true: tu duyet khi so khop duy nhat Workload; khong xac minh chu so bang OTP.
# false: quan tri duyet. Thu hoi/tu choi truoc do van can quan tri mo lai.
REGISTRATION_AUTO_APPROVE=false
# ID quan tri, phan cach bang dau phay; PHAI nam trong ZALO_ALLOWED_USERS.
# De trong thi chua bat dang ky duoc. Chi tu dien ID tren may.
REGISTRATION_ADMIN_USERS=
# Nguon danh tinh doc cung bang ZALO_SHEETS_ID, khong ghi/sua Workload.
# Dung D5=Thanh vien, C5=So dien thoai; khong tu suy doan cot tu ten tab.
REGISTRATION_WORKLOAD_TAB=Workload - Lab coach
REGISTRATION_WORKLOAD_NAME_COLUMN=D
REGISTRATION_WORKLOAD_PHONE_COLUMN=C
REGISTRATION_WORKLOAD_HEADER_ROW=5
REGISTRATION_WORKLOAD_NAME_HEADER=Thành viên
REGISTRATION_WORKLOAD_PHONE_HEADER=Số điện thoại
# URL trang web cu (legacy), KHONG can cho Tickets qua tin nhan rieng Zalo.
# Giu trong neu chi dung chat; huong dan hien tai: docs/tickets-chat.md.
TICKETS_PUBLIC_URL=
# Mac dinh A tao -> B dong y -> quan ly duyet.
TICKETS_REQUIRE_MANAGER=true
# Tickets DM: off, sheets_test, lab_live, lab_live_test. KHONG dung demo tren Zalo that.
TICKETS_CHAT_MODE=off
# Cung du lieu voi trang web thu. Chi chay MOT web/gateway su dung thu muc nay.
TICKETS_DATA_DIR=.runtime/tickets
# Sheets test PHAI la bang RIENG, khac ZALO_SHEETS_ID (khong sua bang Lab o gop).
TICKETS_TEST_SHEETS_ID=
TICKETS_TEST_SHEETS_TAB=TicketsTest
TICKETS_TEST_GOOGLE_CREDENTIALS=secrets/tickets-test-service-account.json
# Chi bat sau khi cap quyen vao bang thu va doc docs/tickets-chat.md.
TICKETS_TEST_WRITE_ENABLED=false
# true la cam ket chi dich vu doi ca duoc ghi bang nay; khong nguoi/tool khac sua.
TICKETS_TEST_EXCLUSIVE_WRITER=false
# lab_live cho moi thanh vien da duyet/lien ket; dung ZALO_SHEETS_ID, chi doi cot D.
# Kiem tra trung gio ca Lab Coach/Key Coach; khong gioi han 2 ten nhu lab_live_test.
# Giu tat ghi cho den khi da xac nhan gio ca va quyen ghi doc quyen.
TICKETS_LAB_WRITE_ENABLED=false
TICKETS_LAB_EXCLUSIVE_WRITER=false
# JSON anh xa buoi thuc te sang start/end HH:MM; dung ten Sang/Chieu/Toi co dau.
# Chi can cac buoi xuat hien trong lich; KHONG tu doan gio.
# O Buoi co gio ro rang thi dung gio cua o; neu thieu ca gio o va anh xa thi chan doi ca.
# De trong van check-lab/import-zalo-users duoc. Xem docs/tickets-chat.md.
TICKETS_LAB_PERIODS_JSON=
# Thu tren Sheets THAT: chi 2 nguoi da xac minh, chi ca tuong lai; bo kiem tra trung ca.
# Che do lab_live_test dung co rieng, KHONG bat ghi lab_live thong thuong.
TICKETS_LAB_TEST_MEMBERS_JSON=[]
TICKETS_LAB_TEST_WRITE_ENABLED=false
TICKETS_LAB_TEST_EXCLUSIVE_WRITER=false

# Trang Admin + kho hoi thoai: mac dinh tat. Xem docs/admin.md.
# AdminDemo dung du lieu gia; AdminCreate tao tai khoan web rieng, nhap mat khau an.
# Bat ca hai co de quan ly thanh vien/hoi thoai. Giu Windows tat neu Railway dang chay.
ZALO_ADMIN_ENABLED=false
ZALO_CONVERSATIONS_ENABLED=false
ZALO_CONVERSATION_RETENTION_DAYS=30
# Windows: chi truy cap tren may nay. Railway dung mau config/railway.env.example.
ZALO_ADMIN_HOST=127.0.0.1
ZALO_ADMIN_PORT=8787
ZALO_ADMIN_PUBLIC_URL=
# Tuy chon cho Vercel gateway: khoa rieng chi server biet (32-256 ASCII, khong khoang trang).
# Neu bat, moi request Admin can X-LabCoach-Admin-Proxy; khong dua khoa vao JS/public env.
ZALO_ADMIN_PROXY_SECRET=
