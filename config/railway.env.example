# Mẫu riêng cho Docker/Railway. KHÔNG chép nguyên .env Windows.
# Nhập token/API key/JSON thật trực tiếp trong Railway Variables.
# Đọc docs/deploy-railway.md, giữ false cho đến khi dừng bot Windows + chuyển dữ liệu.
BOT_START_ENABLED=false
BOT_DATA_DIR=/data
HERMES_HOME=/data/hermes-home
HERMES_EXECUTABLE=/usr/local/bin/hermes
ZALO_STATE_DIR=/data/hermes-home/data/zalo
TICKETS_DATA_DIR=/data/tickets
ZALO_KNOWLEDGE_DIR=/data/knowledge

# Ví dụ model, không bảo đảm miễn phí hoặc luôn khả dụng.
HERMES_PROVIDER=openrouter
HERMES_MODEL=openrouter/free
OPENROUTER_API_KEY=
# Tùy chọn hiểu ý bằng AI; dùng nguyên provider/model/key ở trên.
# Chỉ bật sau khi đã triển khai code mới và kiểm tra model. Xem docs/ngon-ngu-tu-nhien.md.
ZALO_NLU_ENABLED=false
ZALO_NLU_TIMEOUT_SECONDS=12

ZALO_BOT_TOKEN=
# Giữ quản trị / người cấp quyền thủ công và nhóm như hệ thống hiện tại.
# Thành viên Workload đã duyệt không cần thêm từng ID ở đây.
ZALO_ALLOWED_USERS=
ZALO_ALLOWED_GROUPS=
ZALO_GROUP_ACCESS=allowlist

# Dán cả JSON vào một giá trị biến Railway; không commit JSON.
ZALO_GOOGLE_CREDENTIALS_SECRET_JSON=
ZALO_GOOGLE_CREDENTIALS=/data/secrets/google-service-account.json
ZALO_SHEETS_ID=
ZALO_SHEETS_USERS=
ZALO_SHEETS_GROUPS=
ZALO_CALENDAR_FORMAT=lab
# Điền đúng danh sách tab đang dùng; giữ nguyên khi chuyển máy.
ZALO_CALENDAR_TABS_JSON=[]
ZALO_CALENDAR_TAB=Lich
ZALO_ISSUES_TAB=Issues
ZALO_ISSUES_ENABLED=false
# legacy giữ luồng Sheets cũ; managed dùng Admin/SQLite trên Volume.
# off tắt thao tác/thông báo Issue và giữ dữ liệu.
# Chỉ bật managed sau đối soát snapshot đầy đủ, kể cả nguồn trống. Xem docs/ISSUES.md.
ZALO_ISSUES_MODE=legacy

# Chuyển hệ thống đang dùng Workload: giữ đúng giá trị hiện có và bật true.
REGISTRATION_ENABLED=false
# true: tự duyệt số khớp duy nhất Workload; không xác minh quyền sở hữu số.
REGISTRATION_AUTO_APPROVE=false
REGISTRATION_ADMIN_USERS=
REGISTRATION_WORKLOAD_TAB=Workload - Lab coach
REGISTRATION_WORKLOAD_NAME_COLUMN=D
REGISTRATION_WORKLOAD_PHONE_COLUMN=C
REGISTRATION_WORKLOAD_HEADER_ROW=5
REGISTRATION_WORKLOAD_NAME_HEADER=Thành viên
REGISTRATION_WORKLOAD_PHONE_HEADER=Số điện thoại

# Giữ off lúc chuẩn bị; sau khi chuyển dùng lại chế độ hiện tại (vd lab_live).
TICKETS_CHAT_MODE=off
TICKETS_REQUIRE_MANAGER=false
TICKETS_PUBLIC_URL=
# Chỉ bật lại ghi sau khi đối chiếu đúng dữ liệu/nguồn lịch.
TICKETS_LAB_WRITE_ENABLED=false
TICKETS_LAB_EXCLUSIVE_WRITER=false
# Giờ đã xác nhận cho dự án này; Chiều và Tối chồng 30 phút.
TICKETS_LAB_PERIODS_JSON={"Sáng":{"start":"09:00","end":"13:00"},"Chiều":{"start":"14:00","end":"18:00"},"Tối":{"start":"17:30","end":"20:30"}}

# Tùy chọn cho chế độ thử; không tự bật khi deploy.
TICKETS_LAB_TEST_MEMBERS_JSON=[]
TICKETS_LAB_TEST_WRITE_ENABLED=false
TICKETS_LAB_TEST_EXCLUSIVE_WRITER=false
TICKETS_TEST_SHEETS_ID=
TICKETS_TEST_SHEETS_TAB=TicketsTest
TICKETS_TEST_GOOGLE_CREDENTIALS_SECRET_JSON=
TICKETS_TEST_GOOGLE_CREDENTIALS=/data/secrets/tickets-test-service-account.json
TICKETS_TEST_WRITE_ENABLED=false
TICKETS_TEST_EXCLUSIVE_WRITER=false

# Admin chạy cùng tiến trình bot, dùng cùng Volume; không tạo bot/replica thứ hai.
# Mặc định tắt. Chỉ bật sau khi tạo tài khoản riêng và chuẩn bị HTTPS; docs/admin.md.
ZALO_ADMIN_ENABLED=false
ZALO_CONVERSATIONS_ENABLED=false
ZALO_CONVERSATION_RETENTION_DAYS=30
ZALO_ADMIN_HOST=0.0.0.0
ZALO_ADMIN_PUBLIC_URL=
# Khi dùng Vercel gateway: đặt khóa ngẫu nhiên riêng 32–256 ký tự ASCII, không khoảng trắng.
# Vercel server gửi X-LabCoach-Admin-Proxy; không gửi khóa ra trình duyệt hoặc NEXT_PUBLIC_*.
# PUBLIC_URL vẫn là gốc HTTPS backend Railway; khóa không thay đăng nhập/quyền/CSRF Admin.
ZALO_ADMIN_PROXY_SECRET=
# Không đặt ZALO_ADMIN_PORT=8787 trên Railway: để trống/bỏ biến, dùng PORT được cấp.
# PUBLIC_URL cần đúng gốc HTTPS, ví dụ https://ten-domain-admin-cua-ban, không có /path.
