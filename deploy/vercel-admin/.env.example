# Server-only variables in Vercel. Never add NEXT_PUBLIC_/VITE_ prefixes.
LABCOACH_API_URL=https://your-service.up.railway.app
LABCOACH_FRONTEND_URL=https://your-admin.vercel.app
# Generate a random secret (32-256 printable ASCII characters, no whitespace).
# The same secret is configured as ZALO_ADMIN_PROXY_SECRET on Railway.
LABCOACH_PROXY_SECRET=
